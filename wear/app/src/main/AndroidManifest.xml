<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptic feedback grammar for command acks/failures (issue #20). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Issue #134: the in-app listening screen records through SpeechRecognizer
         (runtime-granted on first dictation; denial falls back to the system
         recognizer activity, which records under its own permission). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Held-Wi-Fi escalation when the BT-proxy path to the bridge is broken:
         ConnectivityManager.requestNetwork(TRANSPORT_WIFI) in WifiNetworkEscalator. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- mDNS/NSD zero-typing discovery + DHCP self-heal (issue #23). The
         WifiManager MulticastLock (mDNS RX is dropped without it) needs
         CHANGE_WIFI_MULTICAST_STATE; obtaining WifiManager at all needs
         ACCESS_WIFI_STATE (CHANGE_WIFI_STATE above is a DIFFERENT permission and
         does not cover it). INTERNET + ACCESS_NETWORK_STATE (already declared)
         and CHANGE_NETWORK_STATE (above, satisfies requestNetwork) cover the
         rest; bindProcessToNetwork needs no permission, and NsdManager
         discovery needs none. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The bridge connection's process lifetime (issue #24): a connectedDevice
         foreground service holds the SSE stream open past activity destroy and
         Doze. CHANGE_NETWORK_STATE above already satisfies the connectedDevice
         prerequisite on API 34+; CHANGE_WIFI_STATE is held alongside it for the
         same escalation surface. POST_NOTIFICATIONS because targetSdk 34: the
         FGS notification (and its OngoingActivity chip) is invisible without
         the runtime grant on API 33+ — denial is tolerated, the service still
         runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android's local-network gate (issue #29): from API 37 every LAN
         socket — NSD multicast, the pairing POST, the SSE stream — needs
         this runtime permission. Below 37 the name is unknown to the
         platform and ignored at install, so declaring it changes nothing on
         today's watches; the declaration is load-bearing for the runtime ask
         (an undeclared permission auto-denies with no dialog). The ask
         itself lives on the pairing surface (HaloOfflineScreen) and fires
         only when the platform gates AND the grant is missing — see
         net/LocalNetworkPermission.kt, including why Android 16's adb-only
         NEARBY_WIFI_DEVICES opt-in vehicle is deliberately not wired. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Predictive-back opt-in (issue #109): on Wear the system back gesture
         is the LEFT-BEZEL edge swipe, and for a non-opted-in app the system
         handles it entirely by itself — the swipe-dismiss finishes the
         activity without ever consulting OnBackPressedDispatcher, which is
         exactly the mid-session exit #109 reports. This flag (API 33+, our
         targetSdk is 34) makes the app's back callbacks visible to the
         system (androidx.activity registers a window OnBackInvokedCallback
         while any enabled OnBackPressedCallback exists), and the MEASURED
         Wear dispatch — identical on the API 33 and 34 emulator images — is:

           * callback registered (HaloApp's BackHandler enabled): the system
             swipe-dismiss is SUPPRESSED — the activity can NEVER be swiped
             away — and the swipe's touches reach the app window like any
             other drag (observed on both images, though emulator-injected
             swipes race SysUI and are sometimes dropped whole), where the
             app's own surface gestures (feed swipe-right = back, pager
             step, page step) own the gesture;
           * no callback registered (home at rest): the system swipe-dismiss
             stands — the edge swipe exits to the watch face;
           * KEYCODE_BACK (the hardware back button, Espresso pressBack)
             routes through the OnBackInvokedDispatcher into the registered
             callback, or falls through to the system exit when none is.

         Round 2 (the SM-L330 22:47 log race): the callback is now ALWAYS
         registered — HaloApp's PredictiveBackHandler — because an enabled
         flag that drops MID-GESTURE (the app's own surface gesture
         navigating while the system gesture is in flight) lets the release
         commit the system's own back, and a plain non-animation callback
         leaves the system running its home-preview (the watch-face peek
         flash). Gesture model v3 (user-decided 2026-08-02) rides that
         machinery: the completion routes the SAME one-step-leftward move a
         surface swipe-right makes, and the app exits ONLY from the SETTINGS
         page — the leftward chain's end — as the handler's own deliberate
         activity.finish() (or the settings swipe-right, its one surface
         twin). Pinned by HaloSystemBackTest — keyevent walks end-to-end,
         the always-registered invariant, the mid-gesture race, plus a real
         edge-swipe injection for the suppression half (the system-dismiss
         half of the old measured story is unreachable now by construction).
         See the PredictiveBackHandler in HaloApp.kt for the routing itself.
         Below API 33 the attribute is ignored and the legacy
         dismiss-from-anywhere stands. -->
    <!-- allowBackup=false (issue #134 follow-up): the platform's auto-backup
         binds its FullBackupAgent INSIDE this process and SIGKILLs it on
         teardown — seen live on the SM-L330 killing the app mid-dictation
         while it was the TOP foreground activity ("FullBackup_native
         measured …" then "Sending signal SIG: 9"). Nothing here is worth
         backing up anyway: the pairing token is sealed with a Keystore key
         that never leaves this device, so a restore could not use it. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Standalone watch app: no phone relay, installs without a companion. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started (never bound) foreground service holding the bridge
             connection open with process lifetime (issue #24). -->
        <service
            android:name=".BridgeSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- The Halo Tile (issue #28): session/connection status one swipe
             from the watch face. exported + BIND_TILE_PROVIDER is the tile
             contract: only the system UI holds that permission, so exported
             here does not mean reachable by other apps. The PREVIEW metadata
             feeds the carousel's "add tile" picker; a real rendered-layout
             screenshot is impractical to keep truthful from a build (it
             would drift from the actual layout the moment the layout
             changes), so the preview is a DERIVED static drawable of the
             ring glyph over black — honest branding rather than a stale
             fake render. -->
        <service
            android:name=".glance.HaloTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_bridge_chip"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- The SHORT_TEXT complication data source (issue #28). Same
             exported-but-system-bind-only contract as the tile.
             UPDATE_PERIOD_SECONDS = 300: pushes from the
             BridgeSessionService collector deliver instant honesty on real
             changes — the 5-minute poll is NOT the update mechanism, it is
             the staleness BOUND for a process killed without onDestroy (LMK,
             OEM battery kill, withheld sticky restart): no death-flip push
             fires there, and a push-only complication would freeze on its
             last healthy value indefinitely — the exact stale-green class
             this issue exists to kill. The tile's 60s freshnessInterval is
             its version of the same net; each poll costs one null-safe
             peek (onComplicationRequest never constructs the singleton). -->
        <service
            android:name=".glance.HaloComplicationService"
            android:exported="true"
            android:label="@string/complication_label"
            android:icon="@drawable/ic_bridge_chip"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>
    </application>
</manifest>
