        "sessionId": "<session-1>"
      }
    }
  },
  {
    "name": "sse: permission-request Bash",
    "event": {
      "event": "permission-request",
      "data": {
        "permissionId": "<permission-1>",
        "sessionId": "<session-1>",
        "tool_name": "Bash",
        "tool_input": {
          "command": "ls -la"
        },
        "options": [
          {
            "behavior": "allow-always",
            "label": "Always Allow"
          },
          {
            "behavior": "allow",
            "label": "Allow"
          },
          {
            "behavior": "deny",
            "label": "Reject"
          }
        ]
      }
    }
  },
  {
    "name": "decision allow-always",
    "request": {
      "method": "POST",
      "path": "/v1/command",
      "authenticated": true,
      "body": {
        "permissionId": "<permission-1>",
        "decision": {
          "behavior": "allow-always"
        }
      }
    },
    "response": {
      "status": 200,
      "body": {
        "ok": true
      }
    }
  },
  {
    "name": "sse: permission-request AskUserQuestion (no top-level options)",
    "event": {
      "event": "permission-request",
      "data": {
        "permissionId": "<permission-2>",
        "sessionId": "<session-1>",
        "tool_name": "AskUserQuestion",
        "tool_input": {
          "questions": [
            {
              "header": "Color",
              "question": "Favorite color?",
              "options": [
                {
                  "label": "Blue"
                },
                {
                  "label": "Red"
                }
              ],
              "multiSelect": false
            },
            {
              "header": "Style",
              "question": "Tabs or spaces?",
              "options": [
                {
                  "label": "Tabs"
                },
                {
                  "label": "Spaces"
                }
              ],
              "multiSelect": false
            }
          ]
        }
      }
    }
  },
  {
    "name": "decision with answers for every question",
    "request": {
      "method": "POST",
      "path": "/v1/command",
      "authenticated": true,
      "body": {
        "permissionId": "<permission-2>",
        "decision": {
          "behavior": "allow"
        },
        "answers": [
          "Blue",
          "Tabs"
        ]
      }
    },
    "response": {
      "status": 200,
      "body": {
        "ok": true
      }
    }
  },
